Options -Indexes 
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  Options +FollowSymLinks
  RewriteEngine On

  # один адрес сайта: без www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # адреса старого сайта (конструктор) → новые, чтобы не потерять позиции в поиске
  RewriteRule ^magazin/(zavarnye-chayniki|voronki|chaynaya-posuda)/?$ https://%{HTTP_HOST}/catalog/aksessuary/$1/ [R=301,L]
  RewriteRule ^magazin/folder/sredstva-dlya-chistki-kofemashin/?$ https://%{HTTP_HOST}/catalog/aksessuary/sredstva-dlya-chistki-kofemashin/ [R=301,L]
  RewriteRule ^magazin/arenda-kofemashin/?$ https://%{HTTP_HOST}/arenda-kofemashin/ [R=301,L]
  # JL 05 в аренду больше не сдаём (только продажа) — старые адреса её аренды ведут на страницу аренды
  RewriteRule ^(magazin/product/jl-05-arenda|arenda-kofemashin/jetinno-jl-05)/?$ https://%{HTTP_HOST}/arenda-kofemashin/ [R=301,L]
  RewriteRule ^magazin/product/jl-15-viva-arenda/?$ https://%{HTTP_HOST}/arenda-kofemashin/jetinno-jl-15-viva/ [R=301,L]
  RewriteRule ^magazin/product/jl-36-arenda/?$ https://%{HTTP_HOST}/arenda-kofemashin/jetinno-jl36/ [R=301,L]
  # карта редиректов сеошника: разделы /magazin/folder/…, старые /chaj, /kofe, снятые товары
  RewriteRule ^magazin/folder/aksessuary/?$ https://%{HTTP_HOST}/catalog/aksessuary/ [R=301,L]
  RewriteRule ^magazin/folder/arenda-kofemashin/?$ https://%{HTTP_HOST}/arenda-kofemashin/ [R=301,L]
  RewriteRule ^magazin/folder/barer-filtry-dlya-vody/?$ https://%{HTTP_HOST}/ [R=301,L]
  RewriteRule ^magazin/folder/botanika-kofe-pod-espresso/?$ https://%{HTTP_HOST}/catalog/kofe/dlya-espresso/ [R=301,L]
  RewriteRule ^magazin/folder/chajnye/?$ https://%{HTTP_HOST}/catalog/aksessuary/chaynaya-posuda/ [R=301,L]
  RewriteRule ^magazin/folder/chay/?$ https://%{HTTP_HOST}/catalog/chay/ [R=301,L]
  RewriteRule ^magazin/folder/chay-travyanoy/?$ https://%{HTTP_HOST}/catalog/chay/travyanoy-chay/ [R=301,L]
  RewriteRule ^magazin/folder/(chernyy-chay|zelenyy-chay|puer|uluny|matcha)/?$ https://%{HTTP_HOST}/catalog/chay/$1/ [R=301,L]
  RewriteRule ^magazin/folder/dobavki-k-chayu-2/?$ https://%{HTTP_HOST}/catalog/chay/dobavki-k-chayu/ [R=301,L]
  RewriteRule ^magazin/folder/filtr-kofe/?$ https://%{HTTP_HOST}/catalog/kofe/filtr-kofe/ [R=301,L]
  RewriteRule ^magazin/folder/fruktovye-chai/?$ https://%{HTTP_HOST}/catalog/chay/fruktovyy-chay/ [R=301,L]
  RewriteRule ^magazin/folder/krasnyj-chaj/?$ https://%{HTTP_HOST}/catalog/chay/krasnyy-chay/ [R=301,L]
  RewriteRule ^magazin/folder/professionalnye-kofe-mashiny-1/?$ https://%{HTTP_HOST}/catalog/professionalnye-kofemashiny/ [R=301,L]
  RewriteRule ^magazin/folder/voronki/?$ https://%{HTTP_HOST}/catalog/aksessuary/voronki/ [R=301,L]
  RewriteRule ^magazin/folder/zavarnye-chajniki/?$ https://%{HTTP_HOST}/catalog/aksessuary/zavarnye-chayniki/ [R=301,L]
  RewriteRule ^magazin/product/(barista-100|barista-roksi|jl31b-bt-mw-bak-dlya-vody-8-litrov-podklyuchenie-k-vodoprovodu)/?$ https://%{HTTP_HOST}/ [R=301,L]
  RewriteRule ^magazin/product/jetinno-jl30/?$ https://%{HTTP_HOST}/catalog/professionalnye-kofemashiny/ [R=301,L]
  RewriteRule ^chaj/?$ https://%{HTTP_HOST}/catalog/chay/ [R=301,L]
  RewriteRule ^(folder/)?kofe/?$ https://%{HTTP_HOST}/catalog/kofe/ [R=301,L]
  # магазин переехал на /catalog/ — все старые адреса /magazin/ одним прыжком
  RewriteRule ^magazin/?$ https://%{HTTP_HOST}/catalog/ [R=301,L]
  RewriteRule ^magazin/(.+?)/?$ https://%{HTTP_HOST}/catalog/$1/ [R=301,L]
  RewriteRule ^news/view/([^/]+)/?$ https://%{HTTP_HOST}/blog/$1/ [R=301,L]
  # журнал переехал с /news/ на /blog/
  RewriteRule ^news/?$ https://%{HTTP_HOST}/blog/ [R=301,L]
  RewriteRule ^news/([^/]+)/?$ https://%{HTTP_HOST}/blog/$1/ [R=301,L]
  RewriteRule ^napishite-nam/?$ https://%{HTTP_HOST}/kontakty/#form [R=301,NE,L]
  RewriteRule ^registraciya/?$ https://%{HTTP_HOST}/personal/ [R=301,L]

  # старые адреса были без слеша на конце — страницам сайта добавляем слеш
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{REQUEST_URI} !^/(bitrix|local|upload)/
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+[^/])$ https://%{HTTP_HOST}/$1/ [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !/bitrix/urlrewrite.php$
  RewriteRule ^(.*)$ /bitrix/urlrewrite.php [L]
  RewriteRule .* - [E=REMOTE_USER:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_dir.c>
  DirectoryIndex index.php index.html
</IfModule>

# статика: CSS/JS Битрикс отдаёт с ?версией, шрифты — с хешем в имени, поэтому кешируем на год; картинки — на месяц
<IfModule mod_expires.c>
  ExpiresActive on
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header append Cache-Control "immutable"
  </FilesMatch>
</IfModule>
